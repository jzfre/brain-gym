{
  "name": "brain-gym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "test:integration": "BRAIN_GYM_INTEGRATION=1 vitest run",
    "eval": "vitest run tests/evals",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "eval:live": "tsx tests/evals/live.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:restart": "tsx scripts/restart-smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-radio-group": "1.2.1",
    "@radix-ui/react-separator": "1.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-tabs": "1.1.1",
    "next": "15.5.29",
    "openai": "6.38.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "autoprefixer": "10.4.20",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "dotenv": "16.4.5",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "lucide-react": "0.460.0",
    "playwright": "1.65.1",
    "postcss": "8.5.33",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "prisma": "5.22.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss": "3.4.14",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "prisma",
      "@prisma/engines"
    ],
    "overrides": {
      "postcss": "8.5.33"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  }
}
