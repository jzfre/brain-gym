# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://brain:brain@localhost:5438/brain_gym?schema=public"

# OpenAI
OPENAI_API_KEY="sk-replace-me"
OPENAI_MODEL="gpt-6-sol"
# none | minimal | low | medium | high | xhigh | max (model-dependent;
# gpt-6-sol documents none, low, medium, high, xhigh, max).
OPENAI_REASONING_EFFORT="xhigh"
# Per-attempt ceiling for OpenAI calls, in milliseconds (SDK default of 10
# minutes is too tight for high reasoning effort + web_search). The client
# makes up to 2 attempts, so worst case is ~2x this per model call.
OPENAI_TIMEOUT_MS="1200000"
# Per-attempt ceiling for evaluation calls (no web_search, pure reasoning:
# under a minute at medium effort, several minutes at xhigh). Kept below the
# generation ceiling so a stalled socket aborts and retries instead of hanging
# for the full 20 min. Clamped to OPENAI_TIMEOUT_MS.
OPENAI_EVAL_TIMEOUT_MS="600000"

# Local single-user MVP
LOCAL_USER_ID="00000000-0000-0000-0000-000000000001"
LOCAL_USER_EMAIL="local@brain-gym.dev"
LOCAL_USER_DISPLAY_NAME="Local User"

# Single-password gate (required). Change-me before first use.
APP_PASSWORD="change-me"

# Server-only secret that signs the session cookie (required, >=32 chars).
# NOT the login password: the cookie is an HMAC over this value, so it never
# reveals APP_PASSWORD and rotating it invalidates all existing sessions.
# Generate with:  openssl rand -hex 32
SESSION_SECRET="change-me-generate-with-openssl-rand-hex-32"

# Host port that the Docker app container binds to. Point your reverse
# proxy (NGINX, Cloudflare Tunnel, etc.) at this port.
APP_PORT=3111

# Semantic duplicate prevention
EMBEDDING_MODEL="text-embedding-3-small"
DEDUP_SIMILARITY_THRESHOLD="0.85"
DEDUP_MAX_RETRIES="3"
DEDUP_NEIGHBOR_K="5"
